# Core voice stack
GRADIUM_API_KEY=your_gradium_api_key
AI_COUSTICS_API_KEY=your_ai_coustics_api_key


# Optional OpenAI-compatible LLM path
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
DEEPGRAM_API_KEY=your_deepgram_api_key
SONIOX_API_KEY=

# Live app triage provider. Leave blank to use the local heuristic in the text demo.
# The live demo can toggle between SLM + LLM and LLM-only from the UI.
# LIVE_DISPATCH_MODE is the server-side fallback if a client does not send a mode.
# Keep TRIAGE_ENGINE=heuristic here for local tests and offline utilities;
# the live server overrides to slm when SLM mode is selected and requires the variables below.
TRIAGE_ENGINE=heuristic
LIVE_DISPATCH_MODE=llm_only
TRIAGE_API_KEY=
TRIAGE_BASE_URL=https://api.pioneer.ai/v1
TRIAGE_DECODER_MODEL=
LIVE_FACT_LEDGER_MODEL=2aca7fde-08b7-4976-8b18-456cb159d1fe
TRIAGE_GLINER_MODEL=3222fde0-c652-4ad4-9be1-108b3d18a3e6
TRIAGE_GLINER_LIVE_ENABLED=false
TRIAGE_GLINER_TIMEOUT_S=2.0
TRIAGE_REQUEST_TIMEOUT_S=15
STT_RESCUE_CONTINUOUS_COMPARE=true

# Optional Google / GCP path via ADC
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_MODEL=gemini-2.5-flash

# Gemini Live API (google-genai SDK). Set GEMINI_API_KEY to enable the Gemini
# Live path. If unset, the app logs a clear startup error and disables only the
# Gemini Live path; everything else keeps working. GEMINI_LIVE_MODEL is optional.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional later integrations
TELLI_API_KEY=
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
