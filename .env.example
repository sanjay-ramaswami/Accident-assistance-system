# =============================================================================
# Real-Time Sequential Decision System for Pre-Hospital Emergency Survival
# Environment configuration template.
#
# Copy to `.env` at the repository root and adjust. NEVER commit a real `.env`.
#   cp .env.example .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list, or * for any origin (development only).
CORS_ORIGIN=http://localhost:5173

# --- Database (Module 11) ----------------------------------------------------
# SQLite is the zero-dependency development default. A relative `file:` URL is
# resolved by Prisma against the directory holding schema.prisma, i.e.
# modules/module_11_database_event_system/prisma/dev.db
# For PostgreSQL, switch the prisma provider (see module 11 README) and use e.g.:
#   postgresql://resus:CHANGE_ME@localhost:5432/resus?schema=public
DATABASE_URL="file:./dev.db"
# Set to true to run the development/demo seed (users, hospitals, ambulances,
# historical emergencies, events and outcomes). Never enable in production.
SEED_DEMO_DATA=false

# --- Authentication / Authorization -------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRES_IN=1h
# Bootstrap operator account created by the seed/migrate step (development only).
SEED_OPERATOR_EMAIL=operator@resus.local
SEED_OPERATOR_PASSWORD=ChangeMe!2024

# --- LLM (Module 5) ----------------------------------------------------------
# Free, local, offline inference. No paid provider calls anywhere in this repo.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Per-request timeout (ms) for LLM calls.
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
# When Ollama cannot be reached the engine degrades to a clearly-labelled
# deterministic heuristic extractor instead of inventing LLM output.
LLM_ALLOW_HEURISTIC_FALLBACK=true
# Number of protocol turns before a session is flagged for escalation review.
PROTOCOL_MAX_CLARIFICATIONS=3
# Protocol catalogue directory (defaults to the module 5 `protocols/` folder).
PROTOCOL_DIR=

# --- Protocol Engine (Module 5) ----------------------------------------------
# Medical content is data, not code. Review protocol versions before use.
PROTOCOL_DEFAULT_VERSION=1.0.0
# Fail closed if a protocol file fails schema validation.
PROTOCOL_STRICT_VALIDATION=true

# --- Ambulance Management (Module 6) -----------------------------------------
# Simulation data is flagged everywhere (is_simulation, `simulated` API field).
# Simulation and production records are never merged silently.
SIMULATION_MODE=false
SIMULATION_TICK_MS=2000
SIMULATION_AMBULANCE_COUNT=8
# Average km/h used for response-time estimation when routing is unavailable.
AMBULANCE_AVERAGE_SPEED_KMH=45
AMBULANCE_DISPATCH_SPEED_KMH=60
# Maximum radius considered by the assignment engine (km).
ASSIGNMENT_MAX_RADIUS_KM=25

# --- Dashboard / Analytics (Module 12) ---------------------------------------
# Analytics windows
ANALYTICS_DEFAULT_WINDOW_DAYS=30
# Minimum historical samples before outcome learning returns model output.
# Below this threshold it returns transparent statistical estimates only.
LEARNING_MIN_SAMPLES_FOR_MODEL=25
# Bayesian prior (Laplace smoothing) for outcome rate estimation.
LEARNING_PRIOR_ALPHA=1
LEARNING_PRIOR_BETA=1

# --- Map / Frontend ----------------------------------------------------------
# Default map centre (used when the dashboard has no focus emergency).
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
MAP_DEFAULT_ZOOM=12
# Free, no-API-key tile source used by the dashboard map.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
