# Copy to .env and edit. NEVER commit .env.
GEMINI_API_KEY=
MOCK_MODE=true

# --- Optional ---
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_SECONDS=10
# Only allow protocols whose JSON has "reviewed": true (leave false for the college prototype)
# REQUIRE_REVIEWED_PROTOCOLS=false
# Let Gemini reword approved step text (numbers are guarded; default off, see README)
# SIMPLIFY_WITH_LLM=false
