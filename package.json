{
  "name": "prehospital-emergency-survival-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-Time Sequential Decision System for Pre-Hospital Emergency Survival - modules 5, 6, 11, 12",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:harness": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate deploy --schema modules/module_11_database_event_system/prisma/schema.prisma && npm run db:generate",
    "db:migrate:dev": "prisma migrate dev --schema modules/module_11_database_event_system/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema modules/module_11_database_event_system/prisma/schema.prisma",
    "db:seed": "tsx modules/module_11_database_event_system/src/seed/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "protocols:validate": "tsx modules/module_05_bystander_assistance/src/protocol_engine/validateCatalogues.ts",
    "ollama:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "ollama:check": "tsx scripts/check-ollama.ts",
    "simulate": "tsx modules/module_06_ambulance_management/src/simulation/run.ts",
    "demo": "tsx scripts/end-to-end-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
