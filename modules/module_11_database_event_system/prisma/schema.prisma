// =============================================================================
// MODULE 11 — DATABASE + EVENT SYSTEM
// Prisma schema: the single source of truth for every table in the system.
//
// Dialect notes
// -------------
// The development default is SQLite so the prototype runs with zero external
// services. SQLite has no native enum and no JSON scalar in Prisma, therefore
// every enumerated column is a `String` validated at the repository boundary by
// the zod schemas in `packages/core/src/domain/schemas.ts`, and every JSON
// document is stored as a serialised `String` (`*Json` suffix) accessed only
// through the typed mappers in `src/models`.
//
// Switching to PostgreSQL: change `provider`, update `DATABASE_URL`, and the
// string columns may optionally be promoted to native enums / jsonb. No code
// outside `src/models` needs to change.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

model User {
  id           String   @id
  email        String   @unique
  displayName  String
  /// bcrypt hash. Plaintext passwords are never stored or logged.
  passwordHash String
  role         String   @default("OPERATOR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outcomes           Outcome[]
  assignments        AmbulanceAssignment[]
  protocolSessions   ProtocolSession[]
  assignedAmbulances Ambulance[]           @relation("AmbulanceAssignedDriver")

  @@index([role])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Emergency core
// -----------------------------------------------------------------------------

model Emergency {
  id                  String   @id
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  status              String   @default("CREATED")
  incidentType        String
  severity            String
  latitude            Float
  longitude           Float
  description         String?
  callerId            String?
  assignedAmbulanceId String?
  selectedHospitalId  String?
  /// Hard provenance flag. Simulation rows are never aggregated together with
  /// production rows unless the caller explicitly opts in.
  isSimulation        Boolean  @default(false)
  address             String?

  assignedAmbulance Ambulance?  @relation("EmergencyAssignedAmbulance", fields: [assignedAmbulanceId], references: [id], onDelete: SetNull)
  selectedHospital  Hospital?   @relation("EmergencySelectedHospital", fields: [selectedHospitalId], references: [id], onDelete: SetNull)
  currentUnits      Ambulance[] @relation("AmbulanceCurrentEmergency")

  callSessions     CallSession[]
  transcripts      Transcript[]
  protocolSessions ProtocolSession[]
  assignments      AmbulanceAssignment[]
  routes           Route[]
  corridor         Corridor?
  decisions        Decision[]
  outcome          Outcome?
  learningSample   LearningSample?
  systemEvents     SystemEvent[]
  patient          Patient?
  notifications    Notification[]

  @@index([status])
  @@index([severity])
  @@index([incidentType])
  @@index([createdAt])
  @@index([isSimulation, status])
  @@map("emergencies")
}

model CallSession {
  id           String    @id
  emergencyId  String
  channel      String    @default("VOICE")
  callerId     String?
  status       String    @default("ACTIVE")
  language     String    @default("en")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  isSimulation Boolean   @default(false)

  emergency   Emergency    @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  transcripts Transcript[]

  @@index([emergencyId])
  @@index([startedAt])
  @@map("call_sessions")
}

model Transcript {
  id            String   @id
  callSessionId String
  emergencyId   String
  sequence      Int
  speaker       String
  text          String
  isFinal       Boolean  @default(true)
  intent        String?
  confidence    Float?
  recordedAt    DateTime @default(now())
  isSimulation  Boolean  @default(false)

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  emergency   Emergency   @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, sequence])
  @@index([emergencyId, sequence])
  @@map("transcripts")
}

// -----------------------------------------------------------------------------
// Module 5 — protocol engine persistence
// -----------------------------------------------------------------------------

model ProtocolSession {
  id                 String    @id
  emergencyId        String
  protocolId         String
  protocolVersion    String
  /// Authoritative guidance the protocol content was transcribed from.
  protocolSource     String
  currentStep        String
  status             String    @default("ACTIVE")
  startedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?
  escalationRequired Boolean   @default(false)
  escalationReason   String?
  clarificationCount Int       @default(0)
  /// Facts extracted and confirmed so far (JSON string).
  collectedFactsJson String    @default("{}")
  /// Which LLM produced the language for this session.
  llmProvider        String    @default("ollama")
  llmModel           String    @default("qwen3:8b")
  degraded           Boolean   @default(false)
  initiatedBy        String    @default("SYSTEM")
  initiatedByUserId  String?

  emergency Emergency      @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  steps     ProtocolStep[]
  user      User?          @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([emergencyId])
  @@index([status])
  @@map("protocol_sessions")
}

model ProtocolStep {
  id                String    @id
  protocolSessionId String
  /// Step identifier inside the versioned protocol catalogue.
  stepId            String
  orderIndex        Int
  status            String    @default("PENDING")
  presentedAt       DateTime?
  completedAt       DateTime?
  resultJson        String?

  protocolSession ProtocolSession @relation(fields: [protocolSessionId], references: [id], onDelete: Cascade)

  @@unique([protocolSessionId, stepId])
  @@index([protocolSessionId, orderIndex])
  @@map("protocol_steps")
}

// -----------------------------------------------------------------------------
// Module 6 — fleet
// -----------------------------------------------------------------------------

model Ambulance {
  id                 String    @id
  vehicleNumber      String    @unique
  status             String    @default("AVAILABLE")
  latitude           Float?
  longitude          Float?
  lastLocationUpdate DateTime?
  currentEmergencyId String?
  assignedAt         DateTime?
  availableAt        DateTime?
  /// JSON array of EQUIPMENT_CODES.
  equipmentJson      String    @default("[]")
  stationName        String?
  isSimulation       Boolean   @default(false)
  assignedDriverId   String?
  /// Odometer-ish counters used by the simulation harness only.
  simulatedSpeedKmh  Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  currentEmergency Emergency?            @relation("AmbulanceCurrentEmergency", fields: [currentEmergencyId], references: [id], onDelete: SetNull)
  assignedTo       Emergency[]           @relation("EmergencyAssignedAmbulance")
  crew             AmbulanceCrew[]
  locations        AmbulanceLocation[]
  assignments      AmbulanceAssignment[]
  assignedDriver   User?                 @relation("AmbulanceAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([isSimulation, status])
  @@index([currentEmergencyId])
  @@map("ambulances")
}

model AmbulanceCrew {
  id               String  @id
  ambulanceId      String
  name             String
  role             String
  /// JSON array of CREW_CAPABILITIES.
  capabilitiesJson String  @default("[]")
  isOnDuty         Boolean @default(true)

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)

  @@index([ambulanceId])
  @@map("ambulance_crew")
}

/// Append-only GPS trail. One row per accepted position report.
model AmbulanceLocation {
  id           String   @id
  ambulanceId  String
  latitude     Float
  longitude    Float
  speedKmh     Float?
  headingDeg   Float?
  accuracyM    Float?
  recordedAt   DateTime @default(now())
  source       String   @default("GPS")
  isSimulation Boolean  @default(false)

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)

  @@index([ambulanceId, recordedAt])
  @@map("ambulance_locations")
}

model AmbulanceAssignment {
  id                       String    @id
  emergencyId              String
  ambulanceId              String
  status                   String    @default("ASSIGNED")
  source                   String    @default("AUTOMATIC")
  distanceKm               Float
  estimatedResponseTimeMin Float
  score                    Float
  /// JSON array of human-readable match factors.
  matchingFactorsJson      String    @default("[]")
  /// JSON map ambulanceId -> why the candidate was rejected.
  rejectedReasonsJson      String    @default("{}")
  overrideReason           String?
  consideredCandidates     Int       @default(0)
  decidedAt                DateTime  @default(now())
  createdAt                DateTime  @default(now())
  releasedAt               DateTime?

  emergency       Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  ambulance       Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  decidedBy       User?     @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByUserId String?

  @@index([emergencyId])
  @@index([ambulanceId])
  @@index([status])
  @@map("ambulance_assignments")
}

// -----------------------------------------------------------------------------
// Hospitals, routing, corridors
// -----------------------------------------------------------------------------

model Hospital {
  id                   String   @id
  name                 String
  latitude             Float
  longitude            Float
  status               String   @default("OPEN")
  /// JSON array of HOSPITAL_CAPABILITIES.
  capabilitiesJson     String   @default("[]")
  traumaLevel          Int      @default(1)
  acceptingEmergencies Boolean  @default(true)
  address              String?
  contactPhone         String?
  isSimulation         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  emergencies     Emergency[]        @relation("EmergencySelectedHospital")
  corridors       Corridor[]
  learningSamples LearningSample[]
  routes          Route[]
  resources       HospitalResource[]

  @@index([status])
  @@map("hospitals")
}

model Route {
  id               String    @id
  emergencyId      String
  ambulanceId      String
  hospitalId       String?
  originName       String    @default("INCIDENT")
  destinationName  String    @default("SCENE")
  originLat        Float
  originLng        Float
  destLat          Float
  destLng          Float
  distanceKm       Float
  /// Encoded polyline points (JSON array of [lat,lng]).
  polylineJson     String    @default("[]")
  progressPct      Float     @default(0)
  status           String    @default("PLANNED")
  estimatedMinutes Float?
  startedAt        DateTime?
  completedAt      DateTime?
  isSimulation     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // --- Module 8 additions ---------------------------------------------------
  /// Which routing provider produced this route (osrm, openrouteservice, mock).
  provider            String  @default("mock")
  /// False for the deterministic development provider and for great-circle
  /// estimates. No consumer may present a non-live route as traffic-aware.
  isLiveTraffic       Boolean @default(false)
  /// Traffic multiplier applied by the provider (1.0 = free flow).
  trafficFactor       Float?
  /// Alternatives considered but not chosen (JSON array of route summaries).
  alternativesJson    String  @default("[]")
  /// Why this route was selected over the alternatives (JSON object).
  selectionReasonJson String  @default("{}")
  /// Number of times the route has been recalculated since generation.
  recalculationCount  Int     @default(0)

  emergency Emergency     @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  hospital  Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  updates   RouteUpdate[]

  @@index([emergencyId])
  @@index([hospitalId])
  @@index([status])
  @@map("routes")
}

model RouteUpdate {
  id          String   @id
  routeId     String
  progressPct Float
  positionLat Float?
  positionLng Float?
  remainingKm Float?
  note        String?
  recordedAt  DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, recordedAt])
  @@map("route_updates")
}

/// A pre-negotiated "emergency corridor": ambulance-to-hospital priority lane.
model Corridor {
  id               String    @id
  emergencyId      String    @unique
  ambulanceId      String
  hospitalId       String
  fromLabel        String
  toLabel          String
  estimatedMinutes Float
  isActive         Boolean   @default(true)
  activatedAt      DateTime  @default(now())
  releasedAt       DateTime?
  isSimulation     Boolean   @default(false)

  // --- Module 9 additions ---------------------------------------------------
  status             String @default("REQUESTED")
  /// SIMULATED | NOTIFY_ONLY | INTEGRATED. Never `INTEGRATED` without a real
  /// traffic-signal or road-user integration actually being configured.
  priorityMode       String @default("SIMULATED")
  /// Corridor half-width in metres. The geofence Module 9 uses to find road
  /// users who need to be warned.
  radiusM            Float  @default(150)
  /// Points along the corridor centre line (JSON array of [lat,lng]).
  geofenceJson       String @default("[]")
  /// Road users detected inside the geofence (JSON array of detections).
  roadUsersJson      String @default("[]")
  /// Junctions where priority was requested (JSON array).
  signalsJson        String @default("[]")
  /// How many times the corridor has been renegotiated.
  renegotiationCount Int    @default(0)

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([status])
  @@map("corridors")
}

// -----------------------------------------------------------------------------
// Module 7 — hospital resources
// -----------------------------------------------------------------------------

/// Live availability a hospital is scored on. A `Hospital` row says what a
/// hospital *is*; these rows say what it has *right now*, and they change
/// independently of the hospital record.
model HospitalResource {
  id           String   @id
  hospitalId   String
  /// ICU_BED | EMERGENCY_BED | OPERATION_THEATRE | SPECIALIST | EQUIPMENT
  resourceType String
  /// The specific code within the type: an EQUIPMENT_CODES value, or a
  /// specialty name such as CARDIOLOGY.
  ///
  /// Empty string, not null, for countable types that have no code (an ICU bed).
  /// SQLite treats NULLs as distinct in a unique index, so a nullable column
  /// would silently permit unlimited duplicate ICU_BED rows for one hospital and
  /// the uniqueness guarantee below would not hold.
  code         String   @default("")
  total        Int      @default(0)
  available    Int      @default(0)
  updatedAt    DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, resourceType, code])
  @@index([hospitalId, resourceType])
  @@map("hospital_resources")
}

// -----------------------------------------------------------------------------
// Modules 3/4 — patient record assembled from the call
// -----------------------------------------------------------------------------

/// What the system knows about the patient. Deliberately minimal: it holds
/// triage-relevant observations, not identity. Name, age and contact details
/// belong in the clinical record system, not in a dispatch log.
model Patient {
  id               String   @id
  emergencyId      String   @unique
  /// Number of people affected. > 1 makes this a multi-casualty incident.
  patientCount     Int      @default(1)
  ageGroup         String?
  sex              String?
  /// ALERT | RESPONSES_TO_VOICE | RESPONSES_TO_PAIN | UNRESPONSIVE | UNKNOWN
  consciousness    String?
  /// NORMAL | LABOURED | GASPNING | AGONISTIC | NOT_BREATHING | UNKNOWN
  breathing        String?
  /// Free-text symptoms exactly as the caller reported them.
  symptomsJson     String   @default("[]")
  /// Caller-reported location text, before it is resolved to coordinates.
  locationText     String?
  /// Human-readable address, when known.
  address          String?
  /// Which facts are still unknown (JSON array of fact names).
  missingFactsJson String   @default("[]")
  /// How each known fact was established: LLM, RULE or OPERATOR (JSON object).
  factSourcesJson  String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([consciousness])
  @@map("patients")
}

// -----------------------------------------------------------------------------
// Module 9 — notifications
// -----------------------------------------------------------------------------

/// A notification the corridor asked to be sent. The row records intent and
/// outcome; whether a real message left the building depends on `delivered` and
/// on the provider recorded in `provider`.
model Notification {
  id            String    @id
  emergencyId   String
  corridorId    String?
  /// PUSH | SMS | VOICE | WEB | IN_APP
  channel       String
  /// Who was told: e.g. "nearby-road-users", "hospital-ed", "operators".
  audience      String
  /// QUEUED | SENT | DELIVERED | FAILED | SUPPRESSED
  status        String    @default("QUEUED")
  provider      String    @default("mock")
  /// False unless a real provider confirmed delivery.
  delivered     Boolean   @default(false)
  /// The message body, retained for audit.
  body          String
  /// Correlated position the notification was raised for, when relevant.
  latitude      Float?
  longitude     Float?
  failureReason String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([status])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Event log
// -----------------------------------------------------------------------------

/// Append-only. `seq` is a monotonic autoincrement key that gives total order
/// without relying on timestamps. UPDATE and DELETE are blocked by database
/// triggers declared in the second migration under prisma/migrations.
model SystemEvent {
  seq          Int      @id @default(autoincrement())
  id           String   @unique
  type         String
  emergencyId  String?
  entityType   String?
  entityId     String?
  /// JSON payload string.
  payloadJson  String   @default("{}")
  /// JSON metadata string.
  metadataJson String?
  actorType    String?
  actorId      String?
  recordedAt   DateTime @default(now())

  emergency Emergency? @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId, seq])
  @@index([type, seq])
  @@index([recordedAt])
  @@index([entityId])
  @@map("system_events")
}

// -----------------------------------------------------------------------------
// Decision + outcome + learning
// -----------------------------------------------------------------------------

model Decision {
  id                    String   @id
  emergencyId           String
  decisionType          String
  ambulanceId           String?
  hospitalId            String?
  /// JSON array of the options that were evaluated.
  optionsConsideredJson String   @default("[]")
  chosen                String
  reasoning             String
  confidence            Float
  actorType             String   @default("SYSTEM")
  actorId               String?
  createdAt             DateTime @default(now())

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId, createdAt])
  @@index([decisionType])
  @@map("decisions")
}

model Outcome {
  id                  String   @id
  emergencyId         String   @unique
  status              String
  provenance          String   @default("REAL_OBSERVED")
  survivalToDischarge Boolean?
  notes               String?
  recordedAt          DateTime @default(now())
  recordedByUserId    String?

  emergency  Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("outcomes")
}

/// One row per completed emergency: the feature vector the outcome-learning
/// layer trains on. Never contains patient-identifying data.
model LearningSample {
  id                  String   @id
  emergencyId         String   @unique
  hospitalId          String?
  emergencyType       String
  severity            String
  responseTimeMin     Float?
  dispatchTimeMin     Float?
  ambulanceDistanceKm Float?
  hospitalDistanceKm  Float?
  protocolUsed        String?
  protocolVersion     String?
  escalationRequired  Boolean  @default(false)
  routeDurationMin    Float?
  transportTimeMin    Float?
  totalDurationMin    Float?
  outcomeStatus       String
  survivalToDischarge Boolean?
  /// JSON feature bag (transparent, human readable).
  featuresJson        String   @default("{}")
  provenance          String   @default("REAL_OBSERVED")
  recordedAt          DateTime @default(now())

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  hospital  Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([emergencyType, recordedAt])
  @@index([provenance])
  @@map("learning_samples")
}

model AnalyticsSnapshot {
  id          String   @id
  windowDays  Int
  /// JSON metric document.
  metricsJson String
  provenance  String   @default("STATISTICAL_ESTIMATE")
  sampleSize  Int      @default(0)
  computedAt  DateTime @default(now())

  @@index([computedAt])
  @@map("analytics_snapshots")
}

/// Append-only model version history for the outcome-learning layer.
model LearningModelVersion {
  id            String   @id
  version       Int      @unique
  samples       Int      @default(0)
  priorAlpha    Float
  priorBeta     Float
  /// JSON posterior counts per outcome status.
  posteriorJson String   @default("{}")
  /// JSON per-stratum (emergencyType x severity) rates.
  strataJson    String   @default("{}")
  method        String   @default("bayesian-dirichlet-laplace")
  note          String?
  createdAt     DateTime @default(now())

  @@index([version])
  @@map("learning_model_versions")
}
